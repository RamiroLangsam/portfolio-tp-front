# Copiá este archivo como .env y completalo.

# URL de conexión de tu base de datos (Neon o Supabase).
# Neon:     Dashboard > Connect > Connection string
# Supabase: Project Settings > Database > Connection string (URI)
DATABASE_URL=

# Puerto en el que corre la API.
PORT=3001

# Origen del frontend permitido por CORS.
CORS_ORIGIN=http://localhost:5173
